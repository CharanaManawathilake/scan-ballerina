{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Ballerina Scan Tool",
          "semanticVersion": "0.12.0",
          "rules": [
            {"id": "ballerina:2", "shortDescription": {"text": "Rule two"}, "defaultConfiguration": {"level": "warning"}},
            {"id": "ballerina:1", "shortDescription": {"text": "Rule one"}, "defaultConfiguration": {"level": "note"}}
          ]
        }
      },
      "artifacts": [
        {"location": {"uri": "a/x#1.bal"}}
      ],
      "results": [
        {
          "ruleId": "ballerina:2", "ruleIndex": 0, "level": "warning", "message": {"text": "Rule two"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "a/x#1.bal", "index": 0}, "region": {"startLine": 7}}}]
        },
        {
          "ruleId": "ballerina:1", "ruleIndex": 1, "level": "note", "message": {"text": "Rule one"},
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "a\\modules\\m\\m.bal"}, "region": {"startLine": 2}}}]
        }
      ]
    }
  ]
}
